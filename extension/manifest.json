{
  "manifest_version": 3,
  "name": "YouPlay",
  "version": "1.8.0",
  "description": "YouPlay — красивый YouTube Music: стили, синхронный текст, визуализатор, без рекламы.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://api.github.com/*",
    "https://soundcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "shield.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "ytapi.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://soundcloud.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "sc-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js",
        "soundcloud.js",
        "hub.js",
        "mobile.js"
      ],
      "css": [
        "themes.css",
        "player.css",
        "sc.css",
        "hub.css",
        "ui2.css",
        "mobile.css",
        "icons.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "sc-page.js"
      ],
      "run_at": "document_start"
    }
  ]
}
